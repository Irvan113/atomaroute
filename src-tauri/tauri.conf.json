{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ATOMA",
  "version": "1.0.0",
  "identifier": "com.atoma.app",
  "build": {
    "frontendDist": "https://atomaroute.com",
    "devUrl": "http://127.0.0.1:8000"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ATOMA - Adaptive Focus & Skill Roadmap",
        "url": "https://atomaroute.com",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": false,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
